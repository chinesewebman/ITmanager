# Dependencies
node_modules/
.pnpm-store/
vendor/

# Build outputs
dist/
build/
bin/
# 只忽略仓库根的构建产物。勿写成无斜杠的 server —— 那会连
# backend/cmd/server/ 源码目录一起忽略，且 rg / IDE / codegraph 会静默跳过它。
/server

# IDE
.idea/
.vscode/
*.swp
*.swo
*.sublime-*

# Environment
.env
.env.local
.env.*.local
*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Testing
coverage/

# Misc
.DS_Store
Thumbs.db
*.bak
*.bak.*
*.tmp

# Database (only exclude dump outputs, not schema.sql which is tracked)
dumps/
*.dump.sql
*.db

# Docker
# 注意：这里曾有一条裸 `Dockerfile` / `.dockerignore` 规则，匹配任意深度，导致
# backend/frontend 的 Dockerfile 永远进不了仓库（G-9 的根因之一）。现在这两个文件
# 是交付物，必须跟踪；只忽略本地覆盖文件。
docker-compose.override.yml
