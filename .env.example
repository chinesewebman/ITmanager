# docker compose 用的环境变量（compose 默认读取同目录 .env）
#
#   cp .env.example .env && chmod 600 .env
#   每个 secret 用 `openssl rand -hex 32` 生成，不要复用、不要提交 .env
#
# 变量名必须与 backend 的 viper 键一致：NMP_ + 配置路径（`.` → `_`）。
# 缺值时 compose 会直接报错退出（${VAR:?}），不会静默用空值启动。
#
# 值里**不要有空格**（如有必须写成 `KEY="a b"`）——宿主机侧 `make db-*` 用 shell
# source 读取本文件，未加引号的空格会被当成命令分隔。`#` 是安全的：宿主侧不用
# make 的 include（它会把 `#` 当注释截断，导致「容器密码对、宿主迁移密码错」）。

# 数据库密码：同时用于 postgres 容器与 api 的 NMP_DATABASE_PASSWORD
NMP_DATABASE_PASSWORD=

# JWT 签名密钥（>= 32 字符）
NMP_AUTH_JWT_SECRET=

# API Key 的 HMAC pepper（>= 32 字符）。缺失时服务启动即拒（fail-closed），
# 且**必须**经环境变量注入——写进 config.yaml 会随镜像/仓库泄漏。
NMP_AUTH_API_KEY_PEPPER=

# 运行模式：debug / release。生产必须显式设为 release（默认 debug 仅为本地开发）。
# 注意：release 会额外强制校验 integrations.netbox.token / glpi.*_token（TODO G-15）。

# === Aux profile (--profile aux 启用, 默认不读) ===
# G-17 / M89 ship 后 aux 服务占位值全 fail-closed. 这些 secret **仅**在
# `docker compose --profile aux up -d` 时才需要; 默认主链起动不读.
# 启用 aux 步骤见 08-部署运维.md §8.3.5.

# NetBox SECRET_KEY (≥ 32 字符随机). 生成: openssl rand -hex 32
NMP_AUX_NETBOX_SECRET_KEY=

# Graylog PASSWORD_SECRET (≥ 32 字符随机). 生成: openssl rand -hex 32
NMP_AUX_GRAYLOG_PASSWORD_SECRET=

# Graylog ROOT_PASSWORD (首次登录用, ≥ 32 字符随机). 生成: openssl rand -hex 32
NMP_AUX_GRAYLOG_ROOT_PASSWORD=

# Graylog ROOT_PASSWORD_SHA2 (NMP_AUX_GRAYLOG_ROOT_PASSWORD 的 sha256sum).
# 生成: echo -n "$NMP_AUX_GRAYLOG_ROOT_PASSWORD" | sha256sum | cut -d' ' -f1
# 例 (NMP_AUX_GRAYLOG_ROOT_PASSWORD="abc"): echo -n "abc" | sha256sum | cut -d' ' -f1
#  → ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
NMP_AUX_GRAYLOG_ROOT_PASSWORD_SHA2=

# Elasticsearch ELASTIC_PASSWORD (≥ 32 字符随机, xpack.security.enabled=true 必填).
# 生成: openssl rand -hex 32
NMP_AUX_ELASTICSEARCH_PASSWORD=
